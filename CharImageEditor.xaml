<Window x:Class="Autoclicker.CharImageEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GIF" Width="250" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" WindowStartupLocation="Manual"
        ResizeMode="NoResize" MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <Style TargetType="{x:Type Button}" x:Key="EditorButton">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#1A1A1A"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Effect"><Setter.Value><DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.35"/></Setter.Value></Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="White" BorderBrush="#D8D8D8" BorderThickness="1" CornerRadius="8" Padding="14">
        <StackPanel>
            <Button Name="CloseXBtn" Content="✕" Width="24" Height="24" FontSize="11" HorizontalAlignment="Right" Background="White" BorderThickness="0" Foreground="#555555" Cursor="Hand" Click="CloseXBtn_Click"/>

            <TextBlock Text="X offset" Foreground="#555555" FontSize="10" Margin="0,4,0,3"/>
            <Slider Name="CharPosXSlider" Style="{StaticResource Sl}" Minimum="-200" Maximum="200" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <TextBlock Text="Y offset" Foreground="#555555" FontSize="10" Margin="0,10,0,3"/>
            <Slider Name="CharPosYSlider" Style="{StaticResource Sl}" Minimum="-200" Maximum="200" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <TextBlock Text="Width increase" Foreground="#555555" FontSize="10" Margin="0,10,0,3"/>
            <Slider Name="CharWidthSlider" Style="{StaticResource Sl}" Minimum="20" Maximum="500" Value="154" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <TextBlock Text="Height increase" Foreground="#555555" FontSize="10" Margin="0,10,0,3"/>
            <Slider Name="CharHeightSlider" Style="{StaticResource Sl}" Minimum="20" Maximum="500" Value="320" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="Slider_ValueChanged"/>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button Name="ResetBtn" Grid.Column="0" Style="{StaticResource EditorButton}" Content="Reset" Height="32" Margin="0,0,5,0" Click="ResetBtn_Click"/>
                <Button Name="SaveBtn" Grid.Column="1" Style="{StaticResource EditorButton}" Content="Save" Height="32" Margin="5,0,0,0" Click="SaveBtn_Click"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>

<Window x:Class="Autoclicker.ConfigManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="300" Height="330" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ShowInTaskbar="False" Topmost="True"
        ResizeMode="NoResize" WindowStartupLocation="Manual">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ConfigButton">
            <Setter Property="Width" Value="118"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Background" Value="#151015"/>
            <Setter Property="BorderBrush" Value="#2B1C2B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Effect">
                                    <Setter.Value><DropShadowEffect Color="#000000" BlurRadius="20" ShadowDepth="0" Opacity="0.9"/></Setter.Value>
                                </Setter>
                                <Setter TargetName="bg" Property="BorderBrush" Value="#000000"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Root" Background="White" CornerRadius="14" BorderBrush="#D8D8D8" BorderThickness="1" Padding="12">
        <StackPanel>
            <TextBlock Text="configs" FontSize="16" Foreground="#1A1A1A" Margin="2,0,0,8"/>
            <ListBox x:Name="ConfigList" Height="170" BorderThickness="0" Background="#F3F3F5" SelectionChanged="ConfigList_SelectionChanged"/>
            <TextBox x:Name="NameBox" Height="32" Margin="0,10,0,8" Padding="8,5" BorderBrush="#CFCFD4"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ConfigButton}" Content="load" Click="Load_Click" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Style="{StaticResource ConfigButton}" Content="save" Click="Save_Click" Margin="4,0,0,0"/>
            </Grid>
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource ConfigButton}" Content="delete" Click="Delete_Click" Margin="0,0,4,0"/>
                <Button Grid.Column="1" Style="{StaticResource ConfigButton}" Content="rename" Click="Rename_Click" Margin="4,0,0,0"/>
            </Grid>
            <TextBlock x:Name="StatusText" Foreground="#8A8A8A" FontSize="11" Margin="2,8,2,0"/>
        </StackPanel>
    </Border>
</Window>

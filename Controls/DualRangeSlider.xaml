<UserControl
	Focusable="False"
	x:Class="Autoclicker.Controls.DualRangeSlider"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
	d:DesignWidth="400"
	Height="40">

	<UserControl.Resources>

		<Style x:Key="RangeThumbStyle" TargetType="{x:Type Thumb}">
			<Setter Property="Width" Value="10" />
			<Setter Property="Height" Value="22" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="{x:Type Thumb}">
						<Grid>

							<Border
								x:Name="Halo"
								Width="38"
								Height="38"
								HorizontalAlignment="Center"
								VerticalAlignment="Center"
								CornerRadius="21.5"
								Background="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccentBrush}"
								Opacity="0.35">
								<Border.Effect>
									<BlurEffect Radius="24" />
								</Border.Effect>
							</Border>

							<Border
								x:Name="Pill"
								CornerRadius="5"
								Background="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccentBrush}"
								BorderBrush="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccentBrush}"
								BorderThickness="1"
								SnapsToDevicePixels="True">
								<Border.Effect>
									<DropShadowEffect
										Color="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccentColor}"
										BlurRadius="27"
										ShadowDepth="0"
										Opacity="0.9" />
								</Border.Effect>
							</Border>
						</Grid>

						<ControlTemplate.Triggers>
							<Trigger Property="IsDragging" Value="True">
								<Setter TargetName="Halo" Property="Opacity" Value="0.6" />
								<Setter TargetName="Halo" Property="Effect">
									<Setter.Value>
										<BlurEffect Radius="32" />
									</Setter.Value>
								</Setter>
								<Setter TargetName="Pill" Property="Effect">
									<Setter.Value>
										<DropShadowEffect
											Color="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccentColor}"
											BlurRadius="40"
											ShadowDepth="0"
											Opacity="1" />
									</Setter.Value>
								</Setter>
							</Trigger>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Pill" Property="Effect">
									<Setter.Value>
										<DropShadowEffect
											Color="{Binding RelativeSource={RelativeSource AncestorType=UserControl}, Path=AccentColor}"
											BlurRadius="32"
											ShadowDepth="0"
											Opacity="0.95" />
									</Setter.Value>
								</Setter>
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

	</UserControl.Resources>

	<Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">

		<Border
			x:Name="TrackBorder"
			Height="35"
			CornerRadius="17.5"
			Background="{DynamicResource ThemeControlBrush}"
			BorderThickness="0">
			<Border.Effect>
				<DropShadowEffect
					Color="{DynamicResource ThemeControlColor}"
					BlurRadius="18"
					ShadowDepth="0"
					Opacity="0.35" />
			</Border.Effect>
		</Border>

		<Canvas x:Name="ThumbCanvas" Height="35" ClipToBounds="False">

			<Thumb
				Focusable="False"
				x:Name="LowerThumb"
				Style="{StaticResource RangeThumbStyle}"
				Canvas.Top="6.5"
				DragDelta="LowerThumb_DragDelta"
				DragStarted="Thumb_DragStarted"
				DragCompleted="Thumb_DragCompleted" />

			<Thumb
				Focusable="False"
				x:Name="UpperThumb"
				Style="{StaticResource RangeThumbStyle}"
				Canvas.Top="6.5"
				DragDelta="UpperThumb_DragDelta"
				DragStarted="Thumb_DragStarted"
				DragCompleted="Thumb_DragCompleted" />

		</Canvas>
	</Grid>
</UserControl>

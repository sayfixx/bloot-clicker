<Window
	x:Class="Autoclicker.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:gif="http://wpfanimatedgif.codeplex.com"
	Title="Bloot Clicker"
	Width="553"
	Height="370"
	WindowStartupLocation="CenterScreen"
	ResizeMode="NoResize"
	Background="#00FFFFFF"
	WindowStyle="None"
	AllowsTransparency="True"
	BorderThickness="0"
	FontFamily="Arial" xmlns:autoclicker="clr-namespace:Autoclicker" xmlns:controls="clr-namespace:Autoclicker.Controls">
    <FrameworkElement.Resources>
        <ResourceDictionary>
            <SolidColorBrush
				Color="{DynamicResource ThemeAccentColor}"
				x:Key="ThemeAccentBrush" />
            <SolidColorBrush
				Color="#33FF88"
				x:Key="ThemeGreenBrush" />
            <Color x:Key="ThemeAccentColor">#FF33E6</Color>
            <Color x:Key="ThemeWindowBackgroundColor">#FFFFFFFF</Color>
            <Color x:Key="ThemeTextColor">#FF1A1A1A</Color>
            <Color x:Key="ThemeMutedColor">#FF9A9A9A</Color>
            <Color x:Key="ThemeControlColor">#FFE5E5EA</Color>
            <Color x:Key="ThemeHoverColor">#FFC8C8CC</Color>
            <SolidColorBrush x:Key="ConfigButtonBackgroundBrush">#FF151515</SolidColorBrush>
            <SolidColorBrush x:Key="ConfigButtonBorderBrush">#FF000000</SolidColorBrush>
            <SolidColorBrush x:Key="ConfigButtonHoverBorderBrush">#FF000000</SolidColorBrush>
            <SolidColorBrush x:Key="ConfigComboPopupBrush">#FF252525</SolidColorBrush>
            <SolidColorBrush x:Key="ConfigComboItemHoverBrush">#FF383838</SolidColorBrush>
            <Color x:Key="ColorPickerGlowColor">#FF000000</Color>
            <SolidColorBrush x:Key="ThemeWindowBackgroundBrush" Color="{DynamicResource ThemeWindowBackgroundColor}" />
            <SolidColorBrush x:Key="ThemeTextBrush" Color="{DynamicResource ThemeTextColor}" />
            <SolidColorBrush x:Key="ThemeMutedBrush" Color="{DynamicResource ThemeMutedColor}" />
            <SolidColorBrush x:Key="ThemeControlBrush" Color="{DynamicResource ThemeControlColor}" />
            <SolidColorBrush x:Key="ThemeHoverBrush" Color="{DynamicResource ThemeHoverColor}" />
            <Style
				TargetType="{x:Type TextBlock}"
				x:Key="{x:Type TextBlock}">
                <Setter
					Property="FontSize"
					Value="12" />
                <Setter
					Property="Foreground"
					Value="#C8E8EA" />
                <Setter
					Property="FontFamily"
					Value="Arial" />
            </Style>
            <Style TargetType="{x:Type ToggleButton}" x:Key="Sq">
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="bg" CornerRadius="7" Background="#0D1A1C" BorderBrush="#1A3035" BorderThickness="0" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="bg" Property="Effect">
                                        <Setter.Value><DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.7" /></Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ToggleButton.IsMouseOver" Value="True" />
                                        <Condition Property="ToggleButton.IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type ToggleButton}" x:Key="SqG">
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="Width" Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="bg" CornerRadius="7" Background="#0D1A1C" BorderBrush="#1A3035" BorderThickness="0" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderThickness" Value="1" />
                                    <Setter TargetName="bg" Property="Effect">
                                        <Setter.Value><DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="10" ShadowDepth="0" Opacity="0.7" /></Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
				TargetType="{x:Type ToggleButton}"
				x:Key="GlowToggle">
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Grid>
                                <Border
									x:Name="bg"
								CornerRadius="14"
								Background="{DynamicResource ThemeControlBrush}"
								BorderThickness="0" />
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderThickness" Value="1" />

                                    <Setter TargetName="bg" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="{DynamicResource ThemeAccentColor}" BlurRadius="25" ShadowDepth="0" Opacity="0.75" />
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ToggleButton.IsMouseOver" Value="True" />
                                        <Condition Property="ToggleButton.IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />

                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
				TargetType="{x:Type ToggleButton}"
				x:Key="GlowToggleNoGlow">
                <Setter Property="FrameworkElement.Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Setter Property="Width" Value="40" />
                <Setter Property="Height" Value="40" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border
								Name="bg"
								CornerRadius="14"
								Background="{DynamicResource ThemeControlBrush}"
								BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="ToggleButton.IsChecked" Value="True">
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ThemeAccentBrush}" />
                                    <Setter TargetName="bg" Property="BorderThickness" Value="1" />

                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="ToggleButton.IsMouseOver" Value="True" />
                                        <Condition Property="ToggleButton.IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="bg" Property="Background" Value="{DynamicResource ThemeHoverBrush}" />

                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="{x:Type Button}" x:Key="TopIconBtn">
                <Setter Property="Width" Value="42" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="KeyboardNavigation.IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style
				TargetType="{x:Type Slider}"
				x:Key="Sl">
                <Setter
					Property="Height"
					Value="32" />
                <Setter
					Property="RangeBase.Minimum"
					Value="1" />
                <Setter
					Property="RangeBase.Maximum"
					Value="25" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Slider}">
                            <Grid>
                                <Border
									Name="track"
									Height="32"
									CornerRadius="16"
									Background="#0D1A1C"
									BorderBrush="#1A3035"
									BorderThickness="1" />
                                <Track
									Name="PART_Track"
									Margin="10,0">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
											Focusable="False">
                                            <Control.Template>
                                                <ControlTemplate
													TargetType="{x:Type RepeatButton}">
                                                    <Border
														Background="#00FFFFFF" />
                                                </ControlTemplate>
                                            </Control.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
											Focusable="False">
                                            <Control.Template>
                                                <ControlTemplate
													TargetType="{x:Type RepeatButton}">
                                                    <Border
														Background="#00FFFFFF" />
                                                </ControlTemplate>
                                            </Control.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb
											Cursor="Hand">
                                            <Control.Template>
                                                <ControlTemplate
													TargetType="{x:Type Thumb}">
                                                    <Border
														Name="thumb"
														Width="5"
														Height="18"
														CornerRadius="2.5"
														Background="#00D4C8"
														RenderTransformOrigin="0.5,0.5">
                                                        <UIElement.RenderTransform>
                                                            <ScaleTransform
																x:Name="thumbScale"
																ScaleX="1"
																ScaleY="1" />
                                                        </UIElement.RenderTransform>
                                                        <UIElement.Effect>
                                                            <DropShadowEffect
																Color="#00D4C8"
																BlurRadius="12"
																ShadowDepth="0"
																Opacity="1" />
                                                        </UIElement.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger
															Property="Thumb.IsDragging"
															Value="True">
                                                            <TriggerBase.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1.6"
																			Duration="0:0:0.1" />
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleY"
																			To="1.2"
																			Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.EnterActions>
                                                            <TriggerBase.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1"
																			Duration="0:0:0.1" />
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleY"
																			To="1"
																			Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.ExitActions>
                                                        </Trigger>
                                                        <Trigger
															Property="UIElement.IsMouseOver"
															Value="True">
                                                            <TriggerBase.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1.3"
																			Duration="0:0:0.12" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.EnterActions>
                                                            <TriggerBase.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1"
																			Duration="0:0:0.12" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Control.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="track"
										Property="UIElement.Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
												Color="#00D4C8"
												BlurRadius="8"
												ShadowDepth="0"
												Opacity="0.35" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter
										TargetName="track"
										Property="BorderBrush"
										Value="#00D4C8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				TargetType="{x:Type Slider}"
				x:Key="ColorSl">
                <Setter
					Property="Height"
					Value="24" />
                <Setter
					Property="RangeBase.Minimum"
					Value="0" />
                <Setter
					Property="RangeBase.Maximum"
					Value="360" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Slider}">
                            <Grid>
                                <Border
									Name="track"
									Height="32"
									CornerRadius="16"
									BorderBrush="#1A3035"
									BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush
											StartPoint="0,0"
											EndPoint="1,0">
                                            <GradientStop
												Color="#FF0000"
												Offset="0.0" />
                                            <GradientStop
												Color="#FFFF00"
												Offset="0.1667" />
                                            <GradientStop
												Color="#00FF00"
												Offset="0.3333" />
                                            <GradientStop
												Color="#00FFFF"
												Offset="0.5" />
                                            <GradientStop
												Color="#0000FF"
												Offset="0.6667" />
                                            <GradientStop
												Color="#FF00FF"
												Offset="0.8333" />
                                            <GradientStop
												Color="#FF0000"
												Offset="1.0" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Track
									Name="PART_Track"
									Margin="10,0">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
											Focusable="False">
                                            <Control.Template>
                                                <ControlTemplate
													TargetType="{x:Type RepeatButton}">
                                                    <Border
														Background="#00FFFFFF" />
                                                </ControlTemplate>
                                            </Control.Template>
                                        </RepeatButton>
                                    </Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
											Focusable="False">
                                            <Control.Template>
                                                <ControlTemplate
													TargetType="{x:Type RepeatButton}">
                                                    <Border
														Background="#00FFFFFF" />
                                                </ControlTemplate>
                                            </Control.Template>
                                        </RepeatButton>
                                    </Track.IncreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb
											Cursor="Hand">
                                            <Control.Template>
                                                <ControlTemplate
													TargetType="{x:Type Thumb}">
                                                    <Border
														Name="thumb"
														Width="8"
														Height="24"
														CornerRadius="4"
														Background="#FFFFFF"
														RenderTransformOrigin="0.5,0.5"
														BorderBrush="#000000"
														BorderThickness="2">
                                                        <UIElement.RenderTransform>
                                                            <ScaleTransform
																x:Name="thumbScale"
																ScaleX="1"
																ScaleY="1" />
                                                        </UIElement.RenderTransform>
                                                        <UIElement.Effect>
                                                            <DropShadowEffect
																Color="#000000"
																BlurRadius="8"
																ShadowDepth="0"
																Opacity="0.5" />
                                                        </UIElement.Effect>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger
															Property="Thumb.IsDragging"
															Value="True">
                                                            <TriggerBase.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1.3"
																			Duration="0:0:0.1" />
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleY"
																			To="1.2"
																			Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.EnterActions>
                                                            <TriggerBase.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1"
																			Duration="0:0:0.1" />
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleY"
																			To="1"
																			Duration="0:0:0.1" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.ExitActions>
                                                        </Trigger>
                                                        <Trigger
															Property="UIElement.IsMouseOver"
															Value="True">
                                                            <TriggerBase.EnterActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1.2"
																			Duration="0:0:0.12" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.EnterActions>
                                                            <TriggerBase.ExitActions>
                                                                <BeginStoryboard>
                                                                    <Storyboard>
                                                                        <DoubleAnimation
																			Storyboard.TargetName="thumbScale"
																			Storyboard.TargetProperty="ScaleX"
																			To="1"
																			Duration="0:0:0.12" />
                                                                    </Storyboard>
                                                                </BeginStoryboard>
                                                            </TriggerBase.ExitActions>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Control.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="track"
										Property="UIElement.Effect">
                                        <Setter.Value>
                                            <DropShadowEffect
												Color="#00D4C8"
												BlurRadius="12"
												ShadowDepth="0"
												Opacity="0.4" />
                                        </Setter.Value>
                                    </Setter>
                                    <Setter
										TargetName="track"
										Property="BorderBrush"
										Value="#00D4C8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				TargetType="{x:Type Button}"
				x:Key="Lnk">
                <Setter
					Property="Background"
					Value="#00FFFFFF" />
                <Setter
					Property="BorderThickness"
					Value="0" />
                <Setter
					Property="Padding"
					Value="0" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="FontSize"
					Value="12" />
                <Setter
					Property="Foreground"
					Value="#00D4C8" />
                <Setter
					Property="FontFamily"
					Value="Arial" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <TextBlock
								Name="t"
								Text="{TemplateBinding Content}"
								FontSize="{TemplateBinding FontSize}"
								Foreground="{TemplateBinding Foreground}" />
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="t"
										Property="Foreground"
										Value="#FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style
				TargetType="{x:Type Button}"
				BasedOn="{StaticResource Lnk}"
				x:Key="LnkR">
                <Setter
					Property="Foreground"
					Value="#FF4444" />
            </Style>
            <Style
				TargetType="{x:Type Button}"
				x:Key="SmBtn">
                <Setter
					Property="Background"
					Value="#0D1A1C" />
                <Setter
					Property="BorderBrush"
					Value="#1A3035" />
                <Setter
					Property="BorderThickness"
					Value="1" />
                <Setter
					Property="Foreground"
					Value="#6ABFC0" />
                <Setter
					Property="FontSize"
					Value="11" />
                <Setter
					Property="FrameworkElement.Cursor"
					Value="Hand" />
                <Setter
					Property="Padding"
					Value="8,3" />
                <Setter
					Property="FontFamily"
					Value="Arial" />
                <Setter
					Property="Template">
                    <Setter.Value>
                        <ControlTemplate
							TargetType="{x:Type Button}">
                            <Border
								Name="bg"
								Background="{TemplateBinding Background}"
								BorderBrush="{TemplateBinding BorderBrush}"
								BorderThickness="{TemplateBinding BorderThickness}"
								CornerRadius="5"
								Padding="{TemplateBinding Padding}">
                                <ContentPresenter
									HorizontalAlignment="Center"
									VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger
									Property="UIElement.IsMouseOver"
									Value="True">
                                    <Setter
										TargetName="bg"
										Property="BorderBrush"
										Value="#00D4C8" />
                                    <Setter
										Property="Foreground"
										Value="#00D4C8" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style TargetType="{x:Type Button}" x:Key="GifSelectBtn">
                <Setter Property="Width" Value="108"/>
                <Setter Property="Height" Value="30"/>
                <Setter Property="Background" Value="{DynamicResource ThemeControlBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource ThemeControlBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Foreground" Value="{DynamicResource ThemeTextBrush}"/>
                <Setter Property="FontSize" Value="14"/>
                <Setter Property="FontFamily" Value="Arial"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="bg" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource ThemeHoverBrush}"/>
                                    <Setter TargetName="bg" Property="Effect">

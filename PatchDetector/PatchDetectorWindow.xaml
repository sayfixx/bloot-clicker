<Window x:Class="Autoclicker.PatchDetector.PatchDetectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:Autoclicker.PatchDetector.ViewModels"
        mc:Ignorable="d"
        Title="Patch Detector"
        Width="380"
        Height="420"
        MinWidth="320"
        MinHeight="300"
        WindowStartupLocation="CenterOwner"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResize">
    <Window.Resources>
        <Style TargetType="Button" x:Key="CloseBtn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#2A5055"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#00D4C8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button" x:Key="ScanBtn">
            <Setter Property="Background" Value="#0D1A1C"/>
            <Setter Property="BorderBrush" Value="#1A3035"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#00D4C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,6"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <TextBlock Text="{TemplateBinding Content}" FontSize="{TemplateBinding FontSize}"
                                       Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#00D4C8"/>
                                <Setter TargetName="bg" Property="Background" Value="#122428"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#0A1418"/>
                                <Setter TargetName="bg" Property="Background" Value="#080E10"/>
                                <Setter Property="Foreground" Value="#2A4A4E"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="#101113" BorderBrush="#1F2328" BorderThickness="1" CornerRadius="18">
        <Border.Clip>
            <RectangleGeometry RadiusX="18" RadiusY="18" Rect="0,0,380,420"/>
        </Border.Clip>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="8" />
                <RowDefinition Height="*" />
                <RowDefinition Height="8" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="4" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="10" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="Transparent" MouseDown="Header_MouseDown">
                <DockPanel Margin="16,12,12,12">
                    <Button x:Name="CloseButton"
                            DockPanel.Dock="Right"
                            Content="✕"
                            Width="28"
                            Height="20"
                            FontSize="14"
                            Click="CloseButton_Click"
                            Style="{StaticResource CloseBtn}" />
                    <TextBlock Text="patch detector"
                               Foreground="#00D4C8"
                               FontSize="13"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,4,0,0">
                <Button x:Name="ScanButton"
                        Content="SCAN PATCHES"
                        Width="200"
                        Height="36"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Click="ScanButton_OnClick"
                        Style="{StaticResource ScanBtn}" />
            </StackPanel>

            <ScrollViewer Grid.Row="4"
                          VerticalScrollBarVisibility="Auto"
                          Margin="16,0,16,0">
                <ItemsControl x:Name="PatchItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:PatchCardViewModel}">
                            <Border Margin="0,0,0,8"
                                    Padding="12,10"
                                    CornerRadius="12"
                                    Background="#0C0E12"
                                    BorderBrush="#1C2631"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Title}"
                                                   Foreground="#F1F6FC"
                                                   FontSize="14"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Category}"
                                                   Foreground="#75869A"
                                                   FontSize="11"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Text="{Binding StatusText}"
                                               Foreground="#25B4FF"
                                               FontSize="13"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="6" Margin="16,0,16,0">
                <TextBlock x:Name="FooterStatusText"
                           Foreground="#4A7A80"
                           FontSize="9"
                           Text="Ready. Press scan to detect patches."
                           TextWrapping="Wrap"/>
            </Border>

            <Border Grid.Row="8" Margin="16,0,16,0">
                <TextBlock x:Name="HashTextBlock"
                           Foreground="#25B4FF"
                           TextWrapping="Wrap"
                           FontSize="11"
                           Text="HASH: -" />
            </Border>
        </Grid>
    </Border>
</Window>
